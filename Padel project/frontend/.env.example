# Padel Arena - Supabase Configuration Template
# Renommez ce fichier en .env et renseignez vos identifiants Supabase.

# L'URL de votre projet Supabase (ex: https://abcde12345.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# La clé publique "anon" (ex: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
